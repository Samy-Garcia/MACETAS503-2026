# ============================================================
# Variables de entorno del backend (Render / local)
# Para local: copia este archivo como ".env" y llena los valores.
# En Render se escriben en Environment > Environment Variables.
# NUNCA subas el archivo .env real a GitHub.
# ============================================================

# --- Base de datos (MongoDB Atlas) ---
DB_URI=

# --- Seguridad: cadena larga y aleatoria para firmar las sesiones (JWT) ---
JWT_SECRET_KEY=

# --- URLs de las apps desplegadas (sin "/" al final) ---
# FRONTEND_URL: la tienda. Wompi regresa al cliente a FRONTEND_URL/pago-3ds
# después del 3D Secure, y además se permite en CORS.
# En local: http://localhost:5173
FRONTEND_URL=
# ADMIN_URL: el panel administrativo (se permite en CORS). En local: http://localhost:5174
ADMIN_URL=
# Otros dominios permitidos en CORS, separados por coma (opcional)
CORS_ORIGINS=

# --- Correo: API HTTP de Brevo ---
BREVO_API_KEY=
# Respaldo con Gmail (opcional): EMAIL_PROVIDER=gmail + las 3 variables de Google OAuth
EMAIL_PROVIDER=brevo
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
USER_EMAIL=
USER_PASSWORD=

# --- Imágenes (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Login con Google ---
GOOGLE_CLIENT_ID=

# --- Wompi (panel.wompi.sv > tu aplicativo) ---
GRANT_TYPE=client_credentials
AUDIENCE=wompi_api
CLIENT_ID=
CLIENT_SECRET=

# --- Flora (asistente de IA, Gemini) ---
GEMINI_API_KEY=
