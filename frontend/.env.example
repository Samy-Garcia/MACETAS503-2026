# URL del backend. En local puedes dejarlo vacío (usa localhost:4000 por defecto).
# En Vercel, configúralo en Project Settings → Environment Variables con la
# URL real de tu backend en Render, ej: https://macetas503-backend.onrender.com
VITE_API_URL=

# Client ID de Google OAuth (el mismo valor que GOOGLE_CLIENT_ID del backend).
# Se obtiene en console.cloud.google.com > Credenciales. Sin esto el botón
# "Continuar con Google" no funciona.
VITE_GOOGLE_CLIENT_ID=
